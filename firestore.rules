rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && 
         request.auth.token.email in ['admin@shopledger.app', 'mdilshadm282@gmail.com', 'djbhai35@gmail.com']) ||
        (request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true)
      );
    }

    function membershipDocId(workspaceId, uid) {
      return 'mem_' + workspaceId + '_' + uid;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/memberships/$(membershipDocId(workspaceId, request.auth.uid)));
    }

    function getMembership(workspaceId) {
      return get(/databases/$(database)/documents/memberships/$(membershipDocId(workspaceId, request.auth.uid))).data;
    }

    function hasWorkspaceRole(workspaceId, allowedRoles) {
      return isWorkspaceMember(workspaceId) && 
        getMembership(workspaceId).role in allowedRoles;
    }

    function isWorkspaceOwner(workspaceId) {
      return hasWorkspaceRole(workspaceId, ['owner']);
    }

    function isWorkspaceAdminOrHigher(workspaceId) {
      return hasWorkspaceRole(workspaceId, ['owner', 'admin']);
    }

    function isWorkspaceManagerOrHigher(workspaceId) {
      return hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager']);
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      // Users can update their own profile, but CANNOT self-elevate to isSuperAdmin or unblock themselves
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin', 'isBlocked', 'blockedReason']))
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Workspaces Collection
    // -------------------------------------------------------------------------
    match /workspaces/{workspaceId} {
      allow read: if isSuperAdmin() || isWorkspaceMember(workspaceId);
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == workspaceId;
      allow update: if (isSuperAdmin() || isWorkspaceAdminOrHigher(workspaceId)) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.id == resource.data.id;
      allow delete: if isSuperAdmin() || isWorkspaceOwner(workspaceId);
    }

    // -------------------------------------------------------------------------
    // Memberships Collection
    // -------------------------------------------------------------------------
    match /memberships/{membershipId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isWorkspaceMember(resource.data.workspaceId)
      ));
      allow create: if isSuperAdmin() || (isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.role == 'owner' &&
         request.resource.id == membershipDocId(request.resource.data.workspaceId, request.auth.uid)) ||
        isWorkspaceOwner(request.resource.data.workspaceId)
      ));
      allow update: if isSuperAdmin() || (isAuthenticated() &&
        isWorkspaceOwner(resource.data.workspaceId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.workspaceId == resource.data.workspaceId);
      allow delete: if isSuperAdmin() || (isAuthenticated() &&
        isWorkspaceOwner(resource.data.workspaceId));
    }

    // -------------------------------------------------------------------------
    // Subscriptions Collection
    // -------------------------------------------------------------------------
    match /subscriptions/{subscriptionId} {
      allow read: if isSuperAdmin() || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isSuperAdmin() || (isAuthenticated() &&
        request.resource.data.planId == 'free' &&
        request.resource.data.priceUSD == 0 &&
        request.resource.data.workspaceId != null &&
        isWorkspaceOwner(request.resource.data.workspaceId));
      // Only platform admins or trusted server endpoints can upgrade subscriptions
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Products Collection
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceManagerOrHigher(request.resource.data.workspaceId);
      allow update: if isWorkspaceManagerOrHigher(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isWorkspaceAdminOrHigher(resource.data.workspaceId);
    }

    // -------------------------------------------------------------------------
    // Stock Movements Collection
    // -------------------------------------------------------------------------
    match /stock_movements/{movementId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if false; // Immutable audit trail
    }

    // -------------------------------------------------------------------------
    // Customers Collection
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isWorkspaceAdminOrHigher(resource.data.workspaceId);
    }

    // -------------------------------------------------------------------------
    // Suppliers Collection
    // -------------------------------------------------------------------------
    match /suppliers/{supplierId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceManagerOrHigher(request.resource.data.workspaceId);
      allow update: if isWorkspaceManagerOrHigher(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isWorkspaceAdminOrHigher(resource.data.workspaceId);
    }

    // -------------------------------------------------------------------------
    // Sales Collection
    // -------------------------------------------------------------------------
    match /sales/{saleId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isWorkspaceManagerOrHigher(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false; // Financial records cannot be deleted; must be refunded
    }

    // -------------------------------------------------------------------------
    // Purchases Collection
    // -------------------------------------------------------------------------
    match /purchases/{purchaseId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceManagerOrHigher(request.resource.data.workspaceId);
      allow update: if isWorkspaceManagerOrHigher(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Customer Ledger Collection
    // -------------------------------------------------------------------------
    match /customer_ledger/{ledgerId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if false; // Immutable double-entry ledger
    }

    // -------------------------------------------------------------------------
    // Supplier Ledger Collection
    // -------------------------------------------------------------------------
    match /supplier_ledger/{ledgerId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceManagerOrHigher(request.resource.data.workspaceId);
      allow update, delete: if false; // Immutable ledger
    }

    // -------------------------------------------------------------------------
    // Expenses Collection
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isWorkspaceManagerOrHigher(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isWorkspaceAdminOrHigher(resource.data.workspaceId);
    }

    // -------------------------------------------------------------------------
    // Payment Proofs (USDT TRC20 / BEP20)
    // -------------------------------------------------------------------------
    match /payment_proofs/{proofId} {
      allow read: if isSuperAdmin() || isWorkspaceMember(resource.data.workspaceId);
      // Users can submit payment proofs, but CANNOT set status to 'approved'
      allow create: if isAuthenticated() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only platform admin can approve or reject payment proofs
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Payment Tx Hashes (Duplicate prevention ledger)
    // -------------------------------------------------------------------------
    match /payment_tx_hashes/{txHash} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Payment History Records
    // -------------------------------------------------------------------------
    match /payment_history/{historyId} {
      allow read: if isSuperAdmin() || isWorkspaceMember(resource.data.workspaceId);
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Platform Settings & Configuration
    // -------------------------------------------------------------------------
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /platform_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Audit Notes & Operation Journal
    // -------------------------------------------------------------------------
    match /audit_notes/{noteId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        (resource.data.authorUid == request.auth.uid || isWorkspaceOwner(resource.data.workspaceId));
      allow delete: if isWorkspaceAdminOrHigher(resource.data.workspaceId);
    }

    match /operation_journal/{journalId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if false; // Immutable idempotency journal
    }

    // -------------------------------------------------------------------------
    // Platform Admin Audit Logs (Immutable)
    // -------------------------------------------------------------------------
    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false; // Strictly immutable audit log
    }
  }
}
